# Password to open the tool (any username works). Leave empty for no password.
ACCESS_PASSWORD=

# CPU threads the AI model may use. Keep at 2 on shared hosting.
ORT_THREADS=2

# Largest photo accepted, in MB.
MAX_UPLOAD_MB=20

# Where the AI model is downloaded from on first start (about 200 MB).
# MODEL_URL=https://huggingface.co/Carve/LaMa-ONNX/resolve/main/lama_fp32.onnx

# --- Video ---
# Largest video accepted, in MB.
MAX_VIDEO_MB=1024
# CPU threads ffmpeg may use for video. Keep at 2 on shared hosting.
FFMPEG_THREADS=2
# Uploaded/processed videos are deleted after this many hours.
JOB_TTL_HOURS=2
