{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nyasah/feed",
	"title": "Social Feed",
	"category": "embed",
	"icon": "share",
	"description": "Shows one of your social feeds (YouTube, Instagram, Facebook, Threads, TikTok, X, Pinterest, LinkedIn, Snapchat, Reddit).",
	"keywords": [
		"social",
		"feed",
		"instagram",
		"youtube",
		"tiktok"
	],
	"textdomain": "nyasah-social-feed",
	"attributes": {
		"feed": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "nyasah-block"
}
