# Transara service
Options -Indexes
<FilesMatch "^(config\.php|config\.sample\.php|cron\.php|worker\.php|install\.php|.*\.md)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule ^app/ - [F,L]
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^ index.php [QSA,L]
</IfModule>
