# Copy to .env on the server (never commit .env).
SHOPIFY_API_KEY=your-client-id
SHOPIFY_API_SECRET=your-client-secret
SHOPIFY_APP_URL=https://sarala.laghavi.site
SHOPIFY_APP_HANDLE=sarala-user-access
SCOPES=read_customers,write_customers,customer_read_customers,customer_write_customers
# MySQL database for login sessions only (create it in hPanel > Databases).
DATABASE_URL=mysql://user:password@127.0.0.1:3306/sarala
PORT=3000
NODE_ENV=production
