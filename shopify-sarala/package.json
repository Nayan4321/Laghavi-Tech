{
  "name": "sarala-user-access",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Sarala User Access for Shopify: PHP server (php/) for shared hosting, admin pages (web/) built into php/assets/app.js, and Shopify extensions.",
  "scripts": {
    "build": "esbuild web/main.tsx --bundle --minify --format=esm --jsx=automatic --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=php/assets/app.js",
    "deploy": "shopify app deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && php tests/php-tests.php"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "7.18.6"
  },
  "devDependencies": {
    "@shopify/app-bridge-types": "^0.7.4",
    "@shopify/polaris-types": "^2.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
