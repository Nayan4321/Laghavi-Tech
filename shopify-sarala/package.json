    "@shopify/shopify-app-react-router": "^4.0.3",
    "@shopify/shopify-app-session-storage-mysql": "^8.0.3",
    "isbot": "^5.1.0",
    "mysql2": "^3.11.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "7.18.6"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.6",
    "@shopify/polaris-types": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
