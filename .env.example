# --- Zenoti ---
# From "Create the backend app and generate a new API key" (Configuration > Apps).
# Pick the API host that matches your Zenoti data center/region:
#   US:   https://api.zenoti.com
#   UAE:  https://api.zenoti.ae
#   EU:   https://api.zenoti.eu (check with your Zenoti rep if unsure)
ZENOTI_API_URL=https://api.zenoti.com
ZENOTI_API_KEY=paste_the_generated_api_key_here

# Optional: if guest search must be limited to one center, put its center_id here.
# Leave blank to search across the whole org (needs "Search Guest Across Centers" enabled in Zenoti).
ZENOTI_CENTER_ID=

# Optional: once you know the real URL pattern for an open guest profile in your
# Zenoti web app (ask your Zenoti admin, or copy it from the address bar while
# viewing any client), put a template here using {guest_id} and {center_id}.
# Example: https://yourbusiness.zenoti.com/Home/Guest/{guest_id}
# If left blank, the app opens its own simple guest-details page instead (which
# always works, since it's just calling the Zenoti API directly).
ZENOTI_GUEST_URL_TEMPLATE=

# --- CallGear webhook protection ---
# Make up any random long string. You'll add it as ?token=... on the webhook
# URL you give CallGear, so random internet traffic can't trigger lookups.
WEBHOOK_TOKEN=change_me_to_a_random_string

# --- Server ---
PORT=3000
